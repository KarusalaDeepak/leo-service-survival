    "disseminate_ms": {"type": "number"},
    "install_ms": {"type": "number"},
    "switch_ms": {"type": "number"},
    "total_loop_ms": {"type": "number"},
    "rollback_install_ms": {"type": "number"},
    "rollback_switch_ms": {"type": "number"},
    "rollback_total_ms": {"type": "number"},
    "action_total_ms": {"type": "number"},
    "raw_telemetry_sha256": {"type": "string", "format": "sha256"},
    "required_bytes": {"type": "integer"},
    "delivered_bytes": {"type": "integer"},
    "deadline_wall_ns": {"type": "integer"},
    "completion_wall_ns": {"type": "integer"},

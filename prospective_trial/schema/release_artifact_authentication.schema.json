{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/o4/release-artifact-authentication.schema.json",
  "title": "Objective 4 authenticated release artifact envelope",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_sha256",
    "authentication",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {
      "enum": [
        "frozen_evidence_gate_report",
        "rejection_branch_report",
        "fixed_canary_plan",
        "canary_checkpoint_report",
        "untouched_final_test_unlock",
        "fixed_final_test_plan",
        "end_to_end_trial_audit",
        "prespecified_final_test_itt_analysis",
        "application_outcome_acknowledgement"
      ]
    },
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "purpose", "key_id", "signature"],
      "properties": {
        "algorithm": {"const": "HMAC-SHA256"},
        "purpose": {"type": "string", "minLength": 1},
        "key_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
